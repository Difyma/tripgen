{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "^/assets/(.*)\\.css$",
      "headers": {
        "content-type": "text/css"
      },
      "dest": "/assets/$1.css"
    },
    {
      "src": "^/assets/(.*)\\.js$",
      "headers": {
        "content-type": "application/javascript"
      },
      "dest": "/assets/$1.js"
    },
    {
      "src": "^/assets/(.*)\\.(.*)$",
      "dest": "/assets/$1.$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
} 