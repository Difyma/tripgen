# ============================================
# 🔑 API Keys
# ============================================
# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# 📱 Telegram Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# 🗄️ Supabase Configuration
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# 🏨 Ostrovok (ETG) API Configuration
# https://docs.emergingtravel.com
# ============================================
# Production API URL
OSTROVOK_API_URL=https://api.worldota.net

# ETG API Credentials (Key ID and Token)
OSTROVOK_KEY_ID=your_key_id_here
OSTROVOK_API_TOKEN=your_api_token_here

# ETG SERP timeout for local backend and Vercel serverless search requests
ETG_SEARCH_TIMEOUT_MS=15000

# Legacy fallback (optional)
OSTROVOK_API_KEY=your_api_key_here
OSTROVOK_API_SECRET=your_api_secret_here

# Partner slug for booking links (affiliate string from ETG)
OSTROVOK_PARTNER_SLUG=your_partner_slug_here
OSTROVOK_PARTNER_ID=your_partner_id_here
VITE_OSTROVOK_PARTNER_SLUG=your_partner_slug_here
VITE_OSTROVOK_PARTNER_ID=your_partner_id_here

# Превью отелей: ETG отдаёт URL вида https://cdn.worldota.net/t/{size}/content/…
# https://docs.emergingtravel.com/docs/b2b-api/static-content/retrieve-hotel-content/
# Легаси images.ostrovok.ru у части сетей не резолвится — задайте прокси или same-path (часто 404).
ETG_HOTEL_IMAGE_LEGACY_MODE=none
# ETG_HOTEL_IMAGE_LEGACY_MODE=same-path
# ETG_HOTEL_IMAGE_LEGACY_TARGET_ORIGIN=https://cdn.worldota.net
# ETG_HOTEL_IMAGE_PROXY_BASE=https://your-worker.example.com/img?u=
# ETG_HOTEL_IMAGE_CDN_ORIGIN=https://cdn.worldota.net
VITE_ETG_HOTEL_IMAGE_LEGACY_MODE=none
# VITE_ETG_HOTEL_IMAGE_LEGACY_MODE=same-path
# VITE_ETG_HOTEL_IMAGE_LEGACY_TARGET_ORIGIN=https://cdn.worldota.net
# VITE_ETG_HOTEL_IMAGE_PROXY_BASE=https://your-worker.example.com/img?u=
# VITE_ETG_HOTEL_IMAGE_CDN_ORIGIN=https://cdn.worldota.net

# ============================================
# ✈️ Aviasales/Travelpayouts Configuration
# ============================================
AVIASALES_API_TOKEN=your_aviasales_token_here
AVIASALES_API_URL=https://api.travelpayouts.com/aviasales/v3

# ============================================
# 🧠 Yandex GPT Configuration (optional)
# ============================================
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
VITE_YANDEX_GPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# ============================================
# ⚙️ Application Configuration
# ============================================
PORT=3001
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3001

# ============================================
# 🧪 Development/Test Settings
# ============================================
# Enable test fallback for ETG API
ETG_ENABLE_TEST_FALLBACK=false

# Certification mode: 'real' or 'test_hotels' (frontend)
VITE_CERT_MODE=real
# Same for Vercel serverless / Node (api/openai, gpt proxy)
CERT_MODE=real

# ============================================
# 🐘 PostgreSQL (ETG static dumps, hotel/info sync, rg_ext)
# ============================================
# Нужно для npm run sync:hotels:* и npm run sync:content:hotels
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_pg_password
PGDATABASE=tripgen_etg
# Альтернатива: одна строка для scripts/pg-apply.mjs
# DATABASE_URL=postgresql://user:pass@localhost:5432/tripgen_etg

# Числовые hid через запятую для отдельного job Content API (не в паре с поиском)
# https://docs.emergingtravel.com/docs/b2b-api/static-content/retrieve-hotel-content/
ETG_CONTENT_HIDS=

# ============================================
# 🔒 Security
# ============================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100
